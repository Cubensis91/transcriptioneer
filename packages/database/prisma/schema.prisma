// Milestone 3: authentication. The real knowledge-graph schema begins here
// (User/Organization/OrganizationMember), replacing the Milestone 1
// HealthCheck placeholder. The rest of the graph (KnowledgeItem, Chunk,
// Conversation, etc. — see ARCHITECTURE.md §4) lands incrementally as a
// feature actually needs each entity. SourceFile (Milestone 4) and
// ProcessingJob/Transcript (Milestone 5) are the first of those.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OAuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Null for accounts created via OAuth only (no password ever set).
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  uploadedFiles SourceFile[]
}

/// One row per (provider, external account) a user has linked. A user who
/// registered with a password and later signs in with Google gets a row
/// added here rather than a second User — matched by email at link time,
/// same as most consumer apps' "connect Google to your existing account"
/// behavior (ARCHITECTURE.md §7 doesn't mandate this, but it's the least
/// surprising default and avoids duplicate accounts per email).
model OAuthAccount {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  files   SourceFile[]

  // Milestone 6: shared/reusable-across-the-org extracted entities
  // (ARCHITECTURE.md §4 — "so 'everything about Project X' / 'what did
  // Juan say' is a real query", not siloed per document).
  topics        Topic[]
  keywords      Keyword[]
  tags          Tag[]
  people        Person[]
  organizations OrganizationEntity[]
  locations     Location[]
}

/// Multi-tenant from day one (ARCHITECTURE.md §7) — every later entity
/// (files, transcripts, knowledge items) is scoped through this table via
/// organizationId, not directly through User, so data isolation isn't
/// retrofitted once teams/sharing ship.
model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Refresh tokens are stored hashed (never the raw token), same principle as
/// password hashing — a database leak alone shouldn't let an attacker mint
/// sessions. `replacedByTokenId` chains rotations so presenting an
/// already-rotated token (a signal of theft) can be detected and the whole
/// chain revoked, not just the one token — ARCHITECTURE.md §7's session
/// model ("rotating refresh token").
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacesToken   RefreshToken? @relation("TokenRotation")

  @@index([userId])
}

enum SourceFileStatus {
  /// Row exists (a presigned PUT URL was issued) but the client hasn't
  /// confirmed the upload finished yet — including uploads that never
  /// completed (abandoned tab, network failure).
  PENDING
  /// Uploaded, verified to exist in storage, and passed magic-byte
  /// validation against its declared type.
  UPLOADED
  /// Confirmed but rejected — e.g. the actual file bytes didn't match the
  /// declared mime type. The storage object is deleted when this happens.
  FAILED
}

/// The uploaded artifact itself (ARCHITECTURE.md §4) — Milestone 4's only
/// addition to the knowledge graph. Everything downstream (ProcessingJob,
/// Transcript, Document, KnowledgeItem, ...) hangs off this starting
/// Milestone 5, once transcription/analysis actually needs it.
model SourceFile {
  id             String           @id @default(uuid())
  organizationId String
  uploadedById   String
  /// Object key in the storage bucket — never exposed to clients directly;
  /// all access goes through short-lived presigned URLs (ARCHITECTURE.md §7).
  storageKey     String           @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  status         SourceFileStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  processingJob ProcessingJob?
  transcript    Transcript?
  knowledgeItem KnowledgeItem?

  @@index([organizationId])
}

enum ProcessingStage {
  QUEUED
  TRANSCRIBING
  /// Milestone 6: the transcript exists and aiAnalysisService is turning it
  /// into a KnowledgeItem (ARCHITECTURE.md §6's state machine).
  ANALYZING
  COMPLETED
  FAILED
}

/// One row per SourceFile per pipeline run (ARCHITECTURE.md §6's state
/// machine) — only created for audio/video files, since transcription is
/// the only pipeline that exists yet. `attempts` and `errorMessage` exist
/// so a failed job is diagnosable without grepping worker logs.
model ProcessingJob {
  id           String          @id @default(uuid())
  sourceFileId String          @unique
  stage        ProcessingStage @default(QUEUED)
  errorMessage String?
  attempts     Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sourceFile SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
}

/// Whisper's output for a SourceFile. `segments` is the raw
/// timestamp/speaker-segment JSON Whisper returns when available — stored
/// as-is (ARCHITECTURE.md §6: "preserves timestamps/speaker segments when
/// the model returns them; never fabricates speaker identity"), not
/// normalized into relational rows until a feature actually needs to query
/// across segments.
model Transcript {
  id           String   @id @default(uuid())
  sourceFileId String   @unique
  text         String
  language     String?
  segments     Json?
  createdAt    DateTime @default(now())

  sourceFile SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Milestone 6: AI analysis (ARCHITECTURE.md §4/§6). aiAnalysisService turns a
// Transcript into a KnowledgeItem — structured, queryable rows rather than a
// JSON blob, since ARCHITECTURE.md §4 explicitly calls for entities that need
// to be queried across documents ("everything about Project X", "what did
// Juan say"). Topic/Keyword/Tag and Person/OrganizationEntity/Location are
// shared and deduplicated per Organization (see the Organization model
// above); everything else (EventDate, Decision, Task, Question, OpenIssue,
// Fact, Quote) is owned per KnowledgeItem, not shared.
// ---------------------------------------------------------------------------

/// The structured AI output for a SourceFile's Transcript — one per
/// SourceFile (ARCHITECTURE.md §4).
model KnowledgeItem {
  id              String   @id @default(uuid())
  sourceFileId    String   @unique
  title           String
  summary         String
  detailedSummary String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceFile SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  topics        KnowledgeItemTopic[]
  keywords      KnowledgeItemKeyword[]
  tags          KnowledgeItemTag[]
  people        PersonMention[]
  organizations OrganizationMention[]
  locations     LocationMention[]
  eventDates    EventDate[]
  decisions     Decision[]
  tasks         Task[]
  questions     Question[]
  openIssues    OpenIssue[]
  facts         Fact[]
  quotes        Quote[]
}

/// Reusable across every KnowledgeItem in the org — "everything about
/// Project X" is a real query against this table, not a text search.
model Topic {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        KnowledgeItemTopic[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Keyword {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        KnowledgeItemKeyword[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        KnowledgeItemTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model KnowledgeItemTopic {
  id              String @id @default(uuid())
  knowledgeItemId String
  topicId         String

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  topic         Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, topicId])
  @@index([topicId])
}

model KnowledgeItemKeyword {
  id              String @id @default(uuid())
  knowledgeItemId String
  keywordId       String

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  keyword       Keyword       @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, keywordId])
  @@index([keywordId])
}

model KnowledgeItemTag {
  id              String @id @default(uuid())
  knowledgeItemId String
  tagId           String

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, tagId])
  @@index([tagId])
}

/// Deduplicated per org (ARCHITECTURE.md §4: "'what did Juan say' resolves
/// across documents") — a mention of the same person in two different
/// SourceFiles links to the same Person row, not two separate ones.
model Person {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentions     PersonMention[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Named `OrganizationEntity` (not `Organization`) to avoid colliding with
/// the tenant Organization model above — this is an *extracted mention*
/// ("Acme Corp", "the Senate"), unrelated to multi-tenancy.
model OrganizationEntity {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentions     OrganizationMention[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Location {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentions     LocationMention[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PersonMention {
  id              String  @id @default(uuid())
  knowledgeItemId String
  personId        String
  /// Short excerpt of how/why they were mentioned, straight from the model
  /// output — not re-derived from the transcript at read time.
  context         String?

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  person        Person        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, personId])
  @@index([personId])
}

model OrganizationMention {
  id              String  @id @default(uuid())
  knowledgeItemId String
  organizationId  String
  context         String?

  knowledgeItem KnowledgeItem      @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  organization  OrganizationEntity @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, organizationId])
  @@index([organizationId])
}

model LocationMention {
  id              String  @id @default(uuid())
  knowledgeItemId String
  locationId      String
  context         String?

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, locationId])
  @@index([locationId])
}

/// Owned per KnowledgeItem (not deduplicated/shared) — dates are specific to
/// the document they were extracted from.
model EventDate {
  id              String    @id @default(uuid())
  knowledgeItemId String
  label           String
  /// As extracted, verbatim (e.g. "next Thursday", "March 15, 44 BC") —
  /// never discarded even when `date` below could be resolved, since
  /// resolution can be wrong and the raw text is the audit trail.
  rawText         String
  /// Parsed calendar date when the model could confidently resolve one;
  /// null otherwise (relative/ambiguous dates, ancient dates before
  /// DateTime's usable range, etc.).
  date            DateTime?
  createdAt       DateTime  @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model Decision {
  id              String   @id @default(uuid())
  knowledgeItemId String
  text            String
  createdAt       DateTime @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id              String     @id @default(uuid())
  knowledgeItemId String
  text            String
  status          TaskStatus @default(OPEN)
  assignee        String?
  createdAt       DateTime   @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model Question {
  id              String   @id @default(uuid())
  knowledgeItemId String
  text            String
  createdAt       DateTime @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model OpenIssue {
  id              String   @id @default(uuid())
  knowledgeItemId String
  text            String
  createdAt       DateTime @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model Fact {
  id              String   @id @default(uuid())
  knowledgeItemId String
  text            String
  createdAt       DateTime @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model Quote {
  id              String   @id @default(uuid())
  knowledgeItemId String
  text            String
  speaker         String?
  createdAt       DateTime @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}
