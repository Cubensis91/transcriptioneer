// Milestone 3: authentication. The real knowledge-graph schema begins here
// (User/Organization/OrganizationMember), replacing the Milestone 1
// HealthCheck placeholder. The rest of the graph (ProcessingJob, Transcript,
// KnowledgeItem, Chunk, Conversation, etc. — see ARCHITECTURE.md §4) lands
// incrementally starting Milestone 5, once a feature actually needs each
// entity. SourceFile (Milestone 4) is the first of those.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OAuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Null for accounts created via OAuth only (no password ever set).
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  uploadedFiles SourceFile[]
}

/// One row per (provider, external account) a user has linked. A user who
/// registered with a password and later signs in with Google gets a row
/// added here rather than a second User — matched by email at link time,
/// same as most consumer apps' "connect Google to your existing account"
/// behavior (ARCHITECTURE.md §7 doesn't mandate this, but it's the least
/// surprising default and avoids duplicate accounts per email).
model OAuthAccount {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  files   SourceFile[]
}

/// Multi-tenant from day one (ARCHITECTURE.md §7) — every later entity
/// (files, transcripts, knowledge items) is scoped through this table via
/// organizationId, not directly through User, so data isolation isn't
/// retrofitted once teams/sharing ship.
model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Refresh tokens are stored hashed (never the raw token), same principle as
/// password hashing — a database leak alone shouldn't let an attacker mint
/// sessions. `replacedByTokenId` chains rotations so presenting an
/// already-rotated token (a signal of theft) can be detected and the whole
/// chain revoked, not just the one token — ARCHITECTURE.md §7's session
/// model ("rotating refresh token").
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacesToken   RefreshToken? @relation("TokenRotation")

  @@index([userId])
}

enum SourceFileStatus {
  /// Row exists (a presigned PUT URL was issued) but the client hasn't
  /// confirmed the upload finished yet — including uploads that never
  /// completed (abandoned tab, network failure).
  PENDING
  /// Uploaded, verified to exist in storage, and passed magic-byte
  /// validation against its declared type.
  UPLOADED
  /// Confirmed but rejected — e.g. the actual file bytes didn't match the
  /// declared mime type. The storage object is deleted when this happens.
  FAILED
}

/// The uploaded artifact itself (ARCHITECTURE.md §4) — Milestone 4's only
/// addition to the knowledge graph. Everything downstream (ProcessingJob,
/// Transcript, Document, KnowledgeItem, ...) hangs off this starting
/// Milestone 5, once transcription/analysis actually needs it.
model SourceFile {
  id             String           @id @default(uuid())
  organizationId String
  uploadedById   String
  /// Object key in the storage bucket — never exposed to clients directly;
  /// all access goes through short-lived presigned URLs (ARCHITECTURE.md §7).
  storageKey     String           @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  status         SourceFileStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
