{
  "name": "@transcriptioneer/database",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "pnpm run db:generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run db:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run db:generate && vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@transcriptioneer/config": "workspace:*",
    "prisma": "^6.1.0"
  }
}
