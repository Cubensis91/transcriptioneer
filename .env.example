# Copy this file to .env (repo root) and adjust as needed for local development.
# apps/api reads these via @nestjs/config; apps/web reads only the NEXT_PUBLIC_*
# ones (anything without that prefix is never exposed to the browser).

# ---- apps/api ----------------------------------------------------------
NODE_ENV=development
PORT=4000

# Postgres connection string. Matches docker-compose.yml's local `postgres`
# service by default — pgvector is enabled via the CREATE EXTENSION baked
# into that image (see docker-compose.yml).
DATABASE_URL="postgresql://transcriptioneer:transcriptioneer@localhost:5432/transcriptioneer"

# Origin allowed to call the API (CORS). Must match where apps/web is served.
WEB_APP_URL="http://localhost:3000"

# ---- apps/web ------------------------------------------------------------
# Base URL the browser uses to reach apps/api. NEXT_PUBLIC_* vars are inlined
# into the client bundle at build time — never put secrets in one of these.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Redis / BullMQ (wired starting Milestone 5 — no queues run yet) -----
# Provisioned in docker-compose.yml now so the container is available when
# background job processing is introduced.
REDIS_URL="redis://localhost:6379"

# ---- OpenAI (wired starting Milestone 5/6) --------------------------------
# Never referenced outside packages/ai, and packages/ai is never imported by
# apps/web or apps/mobile — see ARCHITECTURE.md §2/§7.
# OPENAI_API_KEY=

# ---- File storage (wired starting Milestone 4) ---------------------------
# S3-compatible. docker-compose.yml runs MinIO locally for development.
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_BUCKET="transcriptioneer-dev"
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
